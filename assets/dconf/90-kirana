# Kirana OS - pengaturan bawaan desktop (dconf system db "local")
# Ini NILAI AWAL: pengaturan yang diubah user tetap menang.

[org/gnome/desktop/interface]
color-scheme='prefer-dark'
gtk-theme='Orchis-Teal-Dark'
icon-theme='Papirus-Dark'
cursor-theme='Bibata-Modern-Ice'
font-name='Inter 10.5'
document-font-name='Inter 10.5'
monospace-font-name='JetBrains Mono 11'
clock-show-weekday=true
enable-animations=true

[org/gnome/desktop/wm/preferences]
titlebar-font='Inter Semi-Bold 10.5'
button-layout='appmenu:minimize,close'
num-workspaces=4

[org/gnome/desktop/background]
picture-uri='file:///usr/share/backgrounds/kirana/kirana-dinamis.xml'
picture-uri-dark='file:///usr/share/backgrounds/kirana/kirana-dinamis.xml'
picture-options='zoom'

[org/gnome/desktop/screensaver]
picture-uri='file:///usr/share/backgrounds/kirana/senja.png'

[org/gnome/desktop/sound]
theme-name='freedesktop'

[org/gnome/mutter]
dynamic-workspaces=false
center-new-windows=true

[org/gnome/shell]
enabled-extensions=['user-theme@gnome-shell-extensions.gcampax.github.com', 'tilingshell@ferrarodomenico.com']
disabled-extensions=['tiling-assistant@ubuntu.com', 'ding@rastersoft.com']
favorite-apps=['firefox.desktop', 'org.gnome.Nautilus.desktop', 'org.gnome.Terminal.desktop', 'org.gnome.TextEditor.desktop', 'org.gnome.Settings.desktop']

[org/gnome/shell/extensions/user-theme]
name='Kirana'

[org/gnome/shell/extensions/dash-to-dock]
dock-position='BOTTOM'
extend-height=false
dock-fixed=false
autohide=true
intellihide=true
dash-max-icon-size=40
show-trash=false
show-mounts=false
show-apps-at-top=true
transparency-mode='FIXED'
background-opacity=0.55
custom-theme-shrink=true
running-indicator-style='DOTS'
hot-keys=false

[org/gnome/shell/extensions/tilingshell]
enable-autotiling=true
inner-gaps=uint32 10
outer-gaps=uint32 10
enable-window-border=true
window-use-custom-border-color=true
window-border-color='#2BC4B6'
window-border-width=uint32 2
enable-smart-window-border-radius=true
show-indicator=false
enable-blur-snap-assistant=false
enable-blur-selected-tilepreview=false
layouts-json='[{"id":"Kirana Master","tiles":[{"x":0,"y":0,"width":0.6,"height":1,"groups":[1]},{"x":0.6,"y":0,"width":0.4,"height":0.5,"groups":[1,2]},{"x":0.6,"y":0.5,"width":0.4,"height":0.5,"groups":[2,1]}]},{"id":"Kirana Duo","tiles":[{"x":0,"y":0,"width":0.5,"height":1,"groups":[1]},{"x":0.5,"y":0,"width":0.5,"height":1,"groups":[1]}]},{"id":"Kirana Trio","tiles":[{"x":0,"y":0,"width":0.333,"height":1,"groups":[1]},{"x":0.333,"y":0,"width":0.334,"height":1,"groups":[1,2]},{"x":0.667,"y":0,"width":0.333,"height":1,"groups":[2]}]}]'
selected-layouts=[['Kirana Master'], ['Kirana Master'], ['Kirana Master'], ['Kirana Master']]

[org/gnome/desktop/wm/keybindings]
close=['<Super>q', '<Alt>F4']
switch-to-workspace-1=['<Super>1']
switch-to-workspace-2=['<Super>2']
switch-to-workspace-3=['<Super>3']
switch-to-workspace-4=['<Super>4']
move-to-workspace-1=['<Super><Shift>1']
move-to-workspace-2=['<Super><Shift>2']
move-to-workspace-3=['<Super><Shift>3']
move-to-workspace-4=['<Super><Shift>4']
switch-input-source=@as []
switch-input-source-backward=@as []

[org/gnome/shell/keybindings]
toggle-overview=['<Super>space']
show-screenshot-ui=['Print', '<Super><Shift>s']
switch-to-application-1=@as []
switch-to-application-2=@as []
switch-to-application-3=@as []
switch-to-application-4=@as []

[org/gnome/settings-daemon/plugins/media-keys]
custom-keybindings=['/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/kirana-term/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/kirana-web/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/kirana-files/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/kirana-keys/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/kirana-theme/']

[org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/kirana-term]
name='Terminal'
command='gnome-terminal'
binding='<Super>Return'

[org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/kirana-web]
name='Browser'
command='firefox'
binding='<Super>b'

[org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/kirana-files]
name='File'
command='nautilus --new-window'
binding='<Super>f'

[org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/kirana-keys]
name='Contekan shortcut'
command='kirana-keys'
binding='<Super>slash'

[org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/kirana-theme]
name='Ganti tema'
command='kirana-theme'
binding='<Super><Shift>t'

[org/gnome/terminal/legacy/profiles:]
default='b1dcc9dd-5262-4d8d-a863-c897e6d979b9'
list=['b1dcc9dd-5262-4d8d-a863-c897e6d979b9']

[org/gnome/terminal/legacy/profiles:/:b1dcc9dd-5262-4d8d-a863-c897e6d979b9]
visible-name='Kirana'
login-shell=true
use-theme-colors=false
background-color='#11132A'
foreground-color='#DCDCF0'
bold-color-same-as-fg=true
cursor-colors-set=true
cursor-background-color='#2BC4B6'
cursor-foreground-color='#11132A'
palette=['#1B1D36', '#FF5C7A', '#2BC4B6', '#FFD27A', '#6C8CFF', '#B9A4FF', '#4FD6E0', '#DCDCF0', '#4A4870', '#FF7A95', '#5FE0D2', '#FFE29A', '#8CA6FF', '#D0C2FF', '#7FE6EE', '#FFFFFF']
use-system-font=false
font='JetBrains Mono 11'
scrollbar-policy='never'
default-size-columns=100
default-size-rows=28

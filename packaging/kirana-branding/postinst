#!/bin/sh
set -e

in_container() { systemd-detect-virt --container -q 2>/dev/null; }

case "$1" in
  configure)
    /usr/lib/kirana/rebrand install

    # Splash boot & shutdown (Plymouth), termasuk mode teks
    update-alternatives --quiet --install /usr/share/plymouth/themes/default.plymouth default.plymouth \
      /usr/share/plymouth/themes/kirana/kirana.plymouth 200
    update-alternatives --quiet --set default.plymouth /usr/share/plymouth/themes/kirana/kirana.plymouth
    update-alternatives --quiet --install /usr/share/plymouth/themes/text.plymouth text.plymouth \
      /usr/share/plymouth/themes/kirana-text/kirana-text.plymouth 200
    update-alternatives --quiet --set text.plymouth /usr/share/plymouth/themes/kirana-text/kirana-text.plymouth

    # Tema GRUB harus berada di /boot (bisa partisi terpisah)
    if [ -d /boot/grub ]; then
      rm -rf /boot/grub/themes/kirana
      mkdir -p /boot/grub/themes
      cp -r /usr/share/kirana/grub/kirana /boot/grub/themes/kirana
    fi

    /usr/lib/kirana/build-gdm-theme || echo "kirana: tema GDM gagal dibangun (diabaikan)"
    command -v dconf >/dev/null && dconf update || true

    # Pesan terminal bawaan Ubuntu yang tidak relevan
    for m in 10-help-text 50-motd-news 91-contract-ua-esm-status 91-release-upgrade; do
      [ -f /etc/update-motd.d/$m ] && chmod -x /etc/update-motd.d/$m || true
    done

    if ! in_container; then
      command -v update-initramfs >/dev/null && update-initramfs -u || true
      [ -f /boot/grub/grub.cfg ] && command -v update-grub >/dev/null && update-grub || true
    fi
    ;;
  triggered)
    /usr/lib/kirana/build-gdm-theme || true
    ;;
esac
exit 0
